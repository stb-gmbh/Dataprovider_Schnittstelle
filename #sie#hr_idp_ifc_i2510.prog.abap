MODULE CHECK_UC4NM_2510 INPUT.
 CHECK NOT ( /SIE/HR_IDP_A1-UC4NM IS INITIAL ).
 SELECT SINGLE * FROM  USER_ADDR
          WHERE  BNAME  = /SIE/HR_IDP_A1-UC4NM.
 IF SY-SUBRC >< 0.
   MESSAGE E314 WITH /SIE/HR_IDP_A1-UC4NM.
 ENDIF.
ENDMODULE.                 " CHECK_UC4NM_2510  INPUT

