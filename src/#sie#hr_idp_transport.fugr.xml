   <FUNCTIONS>
    <item>
     <FUNCNAME>/SIE/HR_IDP_IFC_LOAD</FUNCNAME>
     <SHORT_TEXT>SAP DP Upload von Schnittstellenlayouts</SHORT_TEXT>
     <CHANGING>
      <RSCHA>
       <PARAMETER>IFC_DATA</PARAMETER>
       <TYP>/SIE/HR_IDP_IFC_DB</TYP>
      </RSCHA>
     </CHANGING>
     <DOCUMENTATION>
      <RSFDO>
       <PARAMETER>IFC_DATA</PARAMETER>
       <KIND>P</KIND>
      </RSFDO>
     </DOCUMENTATION>
    </item>
    <item>
     <FUNCNAME>/SIE/HR_IDP_IFC_SAVE</FUNCNAME>
     <SHORT_TEXT>Kopieren einer Schnittstelle mit und ohne neue Version</SHORT_TEXT>
     <IMPORT>
      <RSIMP>
       <PARAMETER>DB_DATA</PARAMETER>
       <TYP>/SIE/HR_IDP_IFC_DB</TYP>
      </RSIMP>
      <RSIMP>
       <PARAMETER>FL_ENVELOPE</PARAMETER>
       <DEFAULT>&apos;X&apos;</DEFAULT>
       <OPTIONAL>X</OPTIONAL>
       <TYP>XFELD</TYP>
      </RSIMP>
     </IMPORT>
     <EXCEPTION>
      <RSEXC>
       <EXCEPTION>NO_IFACE</EXCEPTION>
      </RSEXC>
     </EXCEPTION>
     <DOCUMENTATION>
      <RSFDO>
       <PARAMETER>DB_DATA</PARAMETER>
       <KIND>P</KIND>
      </RSFDO>
      <RSFDO>
       <PARAMETER>FL_ENVELOPE</PARAMETER>
       <KIND>P</KIND>
      </RSFDO>
      <RSFDO>
       <PARAMETER>NO_IFACE</PARAMETER>
       <KIND>X</KIND>
       <STEXT>Keine Schnittstelle unter diesem Namen bekannt</STEXT>
      </RSFDO>
     </DOCUMENTATION>
    </item>
    <item>
     <FUNCNAME>/SIE/HR_IDP_IFC_VERSION</FUNCNAME>
     <SHORT_TEXT>SAP DP Version</SHORT_TEXT>
     <EXPORT>
