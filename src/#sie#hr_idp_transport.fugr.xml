     <EXPORT>
      <RSEXP>
       <PARAMETER>IFC_DATA</PARAMETER>
       <TYP>/SIE/HR_IDP_IFC_DB</TYP>
      </RSEXP>
     </EXPORT>
     <TABLES>
      <RSTBL>
       <PARAMETER>XML_DATA</PARAMETER>
      </RSTBL>
     </TABLES>
     <DOCUMENTATION>
      <RSFDO>
       <PARAMETER>IFC_DATA</PARAMETER>
       <KIND>P</KIND>
      </RSFDO>
      <RSFDO>
       <PARAMETER>XML_DATA</PARAMETER>
       <KIND>P</KIND>
      </RSFDO>
     </DOCUMENTATION>
    </item>
