      <RSFDO>
       <PARAMETER>DIRECTORY_NOT_FOUND</PARAMETER>
       <KIND>X</KIND>
      </RSFDO>
     </DOCUMENTATION>
    </item>
    <item>
     <FUNCNAME>/SIE/HR_IDP_FILENAMES</FUNCNAME>
     <SHORT_TEXT>SAP DP Erzeugen der Dateinamen für das SAP DP inkl. SD</SHORT_TEXT>
     <IMPORT>
      <RSIMP>
       <PARAMETER>IFCID</PARAMETER>
       <OPTIONAL>X</OPTIONAL>
       <TYP>/SIE/HR_IDP_INTERFACE_ID</TYP>
      </RSIMP>
      <RSIMP>
       <PARAMETER>ITYPE</PARAMETER>
       <TYP>/SIE/HR_IDP_ITYPE</TYP>
      </RSIMP>
      <RSIMP>
       <PARAMETER>VRSNR</PARAMETER>
       <OPTIONAL>X</OPTIONAL>
       <TYP>/SIE/HR_IDP_VERS_NR</TYP>
      </RSIMP>
      <RSIMP>
       <PARAMETER>PROGRAM_NAME</PARAMETER>
       <TYP>REPID</TYP>
      </RSIMP>
      <RSIMP>
       <PARAMETER>LOGICAL_FILENAME</PARAMETER>
       <OPTIONAL>X</OPTIONAL>
       <TYP>FILEINTERN</TYP>
      </RSIMP>
     </IMPORT>
     <EXPORT>
      <RSEXP>
       <PARAMETER>FILEN_DATA</PARAMETER>
       <TYP>TEXT256</TYP>
      </RSEXP>
      <RSEXP>
       <PARAMETER>FILEN_SD</PARAMETER>
       <TYP>TEXT256</TYP>
