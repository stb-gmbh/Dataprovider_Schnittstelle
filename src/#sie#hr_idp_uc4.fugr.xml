      <RSFDO>
       <PARAMETER>INTERFACE_ID</PARAMETER>
       <KIND>P</KIND>
       <STEXT>Schnittstelle</STEXT>
      </RSFDO>
      <RSFDO>
       <PARAMETER>VERSION</PARAMETER>
       <KIND>P</KIND>
       <STEXT>Schnittstellenversion</STEXT>
      </RSFDO>
      <RSFDO>
       <PARAMETER>FILE_NAME</PARAMETER>
       <KIND>P</KIND>
       <STEXT>Schnittstellenausgabedatei</STEXT>
      </RSFDO>
      <RSFDO>
       <PARAMETER>SD_FILE_NAME</PARAMETER>
       <KIND>P</KIND>
       <STEXT>Sendedateinamen</STEXT>
      </RSFDO>
      <RSFDO>
       <PARAMETER>ADHOC_EXEC</PARAMETER>
       <KIND>P</KIND>
       <STEXT>AD-HOC Lauf. UC4 Parameter aus /SIE/HR_IDP_A1</STEXT>
      </RSFDO>
      <RSFDO>
       <PARAMETER>FAILED</PARAMETER>
       <KIND>X</KIND>
       <STEXT>Die Sendedatei konnte nicht erstellt werden</STEXT>
      </RSFDO>
     </DOCUMENTATION>
