      <RSFDO>
       <PARAMETER>IFCID</PARAMETER>
       <KIND>P</KIND>
      </RSFDO>
      <RSFDO>
       <PARAMETER>ITYPE</PARAMETER>
       <KIND>P</KIND>
       <STEXT>Schnittstgellentyp</STEXT>
      </RSFDO>
      <RSFDO>
       <PARAMETER>VRSNR</PARAMETER>
       <KIND>P</KIND>
      </RSFDO>
      <RSFDO>
       <PARAMETER>PROGRAM_NAME</PARAMETER>
       <KIND>P</KIND>
      </RSFDO>
      <RSFDO>
       <PARAMETER>LOGICAL_FILENAME</PARAMETER>
       <KIND>P</KIND>
      </RSFDO>
      <RSFDO>
       <PARAMETER>FILEN_DATA</PARAMETER>
       <KIND>P</KIND>
       <STEXT>Dateiname der Ausgabedatei</STEXT>
      </RSFDO>
      <RSFDO>
       <PARAMETER>FILEN_SD</PARAMETER>
       <KIND>P</KIND>
       <STEXT>Dateiname des Sendeauftrags</STEXT>
