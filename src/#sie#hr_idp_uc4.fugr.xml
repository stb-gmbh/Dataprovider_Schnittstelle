     <FUNCNAME>/SIE/HR_IDP_DIRECTORY</FUNCNAME>
     <SHORT_TEXT>SAP DP Verzeichnis anlegen</SHORT_TEXT>
     <IMPORT>
      <RSIMP>
       <PARAMETER>DIRECTORY</PARAMETER>
       <TYP>TEXT256</TYP>
      </RSIMP>
     </IMPORT>
     <EXCEPTION>
      <RSEXC>
       <EXCEPTION>DIRECTORY_NOT_FOUND</EXCEPTION>
      </RSEXC>
     </EXCEPTION>
