      <RSFDO>
       <PARAMETER>FILE_NOT_FOUND</PARAMETER>
       <KIND>X</KIND>
       <STEXT>Die logischen Namen wurden nicht aufgelöst</STEXT>
      </RSFDO>
     </DOCUMENTATION>
    </item>
    <item>
     <FUNCNAME>/SIE/HR_IDP_GENERATE_SD</FUNCNAME>
     <SHORT_TEXT>SAP DP Generierung eines Sendeauftrages</SHORT_TEXT>
     <IMPORT>
      <RSIMP>
       <PARAMETER>INTERFACE_ID</PARAMETER>
       <TYP>/SIE/HR_IDP_INTERFACE_ID</TYP>
      </RSIMP>
      <RSIMP>
       <PARAMETER>VERSION</PARAMETER>
       <TYP>/SIE/HR_IDP_VERS_NR</TYP>
      </RSIMP>
      <RSIMP>
       <PARAMETER>FILE_NAME</PARAMETER>
       <TYP>TEXT256</TYP>
      </RSIMP>
      <RSIMP>
       <PARAMETER>SD_FILE_NAME</PARAMETER>
       <TYP>TEXT256</TYP>
      </RSIMP>
      <RSIMP>
       <PARAMETER>ADHOC_EXEC</PARAMETER>
       <DEFAULT>SPACE</DEFAULT>
       <OPTIONAL>X</OPTIONAL>
       <TYP>XFELD</TYP>
      </RSIMP>
     </IMPORT>
     <EXCEPTION>
      <RSEXC>
       <EXCEPTION>FAILED</EXCEPTION>
      </RSEXC>
     </EXCEPTION>
