     <LINES>
      <TLINE>
       <TDFORMAT>U1</TDFORMAT>
       <TDLINE>&amp;TITLE&amp;</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>AS</TDFORMAT>
       <TDLINE>SAP DP Korrespondenz</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>U1</TDFORMAT>
       <TDLINE>&amp;PURPOSE&amp;</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>AS</TDFORMAT>
       <TDLINE>Dieses Program ermöglicht den Versand von Informationen über SAP DP</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>Schnittstellen an Verfahrensverantwortliche.</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>U1</TDFORMAT>
       <TDLINE>&amp;INTEGRATION&amp;</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>AS</TDFORMAT>
      </TLINE>
      <TLINE>
       <TDFORMAT>U1</TDFORMAT>
       <TDLINE>&amp;PREREQUISITES&amp;</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>AS</TDFORMAT>
      </TLINE>
      <TLINE>
       <TDFORMAT>U1</TDFORMAT>
       <TDLINE>&amp;FEATURES&amp;</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>AS</TDFORMAT>
       <TDLINE>Der Report erlaubt die Selektion von Schnittstellen entweder nach</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>Statuseigenschaften (z.B. alle freigegebenen Schnittstellen) oder nach</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>Verfallsdatum und die Ausgabe/Versand eines Formulares an die</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>verschiedenenen Verfahrensverantwortliche.</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>U1</TDFORMAT>
       <TDLINE>&amp;ACTIVITIES&amp;</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>AS</TDFORMAT>
      </TLINE>
      <TLINE>
       <TDFORMAT>U1</TDFORMAT>
       <TDLINE>&amp;EXAMPLE&amp;</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>AS</TDFORMAT>
       <TDLINE>Hauptanwendungsgebiet des Reports ist die Benachrichtigung der</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>technischen und fachlichen Ansprechpartner einer Schnittstelle wenn das</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>Verfallsdatum einer Schnittstelle innerhalb der nächsten zwei Monaten</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>liegt. Die Vorgabewerte auf dem Bildschirm sind dann automatisch</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>gefüllt. Sollte der E-Mail versand gewünscht werden, sollte die</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>entsprechende Option selektiert werden. Für diesen Fall steht das</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>Formular /SIE/HR_IDP_IFCG zur Verfügung.</TDLINE>
      </TLINE>
