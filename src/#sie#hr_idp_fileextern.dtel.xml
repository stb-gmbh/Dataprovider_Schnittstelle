    <DDTEXT>Physischer Dateiname des Schnittstellenlaufes</DDTEXT>
    <REPTEXT>physische Datei des Schnittstellenlaufes</REPTEXT>
    <SCRTEXT_S>akt. Datei</SCRTEXT_S>
    <SCRTEXT_M>akt. phys. Datei</SCRTEXT_M>
    <SCRTEXT_L>physische Datei</SCRTEXT_L>
