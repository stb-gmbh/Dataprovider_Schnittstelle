*&---------------------------------------------------------------------*
*&      Module  STATUS_0510  OUTPUT
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
MODULE STATUS_0510 OUTPUT.
  SUPPRESS DIALOG.
  LEAVE TO LIST-PROCESSING AND RETURN TO SCREEN 0.

  SET PF-STATUS 'YES'.
  SET TITLEBAR 'LEG'.
  PERFORM SHOW_LEGEND.

ENDMODULE.                 " STATUS_0510  OUTPUT

*&---------------------------------------------------------------------*
*&      Module  INIT_0500  OUTPUT
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
MODULE INIT_0500 OUTPUT.
  CHECK SY-TCODE NE '/SIE/HR_IDP_IFC_CONF'.
  CLEAR G_IFDATA_VERS.
ENDMODULE.                 " INIT_0500  OUTPUT

*&---------------------------------------------------------------------*
*&      Module  TRANSFER_0500  INPUT
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
MODULE TRANSFER_0500 INPUT.
  PERFORM TRANSFER_0500.
ENDMODULE.                 " TRANSFER_0500  INPUT

*&---------------------------------------------------------------------*
*&      Module  FILL_SELECTION_0500  OUTPUT
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
MODULE FILL_SELECTION_0500 OUTPUT.

  IF G_IFDATA_VERS = /SIE/HR_IDP_RELEASED-VRSNR.
    SELECTION = 'X'.
  ENDIF.

ENDMODULE.                 " FILL_SELECTION_0500  OUTPUT
